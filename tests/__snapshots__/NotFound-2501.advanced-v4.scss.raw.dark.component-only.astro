/**
 * NotFound-2501 — generated from CodeStitch stitch #2501.
 * Source: https://codestitch.app/app/dashboard/stitches/2501
 * Target: Advanced Astro v4 @ a2eb8fd0
 *
 * Draft — needs attention before shipping:
 *   - This component needs 2 more files (src/locales/en/notFound2501.json, src/locales/fr/notFound2501.json) — use Download ZIP, or the imports will not resolve.
 *   - Advanced Astro v4 ships with LESS only — run "npm i -D sass" in the project before using this SCSS component.
 *   - The fr locale file holds the English copy — translate it before this goes live.
 */

// Utils
import { getSiteContext } from "@js/getSiteContext";
import { getRoute } from "@js/routes";

// Data
import navData from "@data/navData.json";
import type { NavItem } from "src/typescript/global";

const { locale, content } = await getSiteContext(Astro.url);

// This kit translates a slug in navData.json and adds the locale prefix
// in getRoute. Reading navData at runtime means a destination follows
// the project's own routes rather than the ones this component shipped with.
const navUrlsFor = (items: NavItem[], path: string): Record<string, string> | undefined => {
	for (const item of items) {
		const canonical = (item.urls?.["en"] ?? "").replace(/\/+$/, "") || "/";
		if (canonical === path) return item.urls;
		const nested = item.children?.length ? navUrlsFor(item.children, path) : undefined;
		if (nested) return nested;
	}
	return undefined;
};

const routeFor = (path: string): string => {
	const marker = path.search(/[?#]/);
	const base = marker === -1 ? path : path.slice(0, marker);
	const suffix = marker === -1 ? "" : path.slice(marker);
	const urls = navUrlsFor(navData as NavItem[], base.replace(/\/+$/, "") || "/");
	return getRoute(locale, urls?.[locale] ?? urls?.["en"] ?? base) + suffix;
};
