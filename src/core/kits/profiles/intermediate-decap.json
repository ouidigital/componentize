{
	"key": "intermediate-decap",
	"kitId": "decap",
	"label": "Intermediate Astro + Decap CMS",
	"repo": "CodeStitchOfficial/Intermediate-Astro-Decap-CMS",
	"sha": "7f1d82ef93ae8641b9aca883480c2b4c865cc50b",
	"kitVersion": "4.0.0",
	"astroVersion": "^7.0.9",
	"configPath": "astro.config.mjs",
	"generation": "decap",
	"compressHTML": "jsx",
	"prefixDefaultLocale": false,
	"hasLess": true,
	"hasSass": false,
	"aliases": [
		"@layouts/*",
		"@assets/*",
		"@data/*",
		"@styles/*",
		"@components/*",
		"@js/*"
	],
	"locales": [],
	"defaultLocale": null,
	"namespaceFiles": [],
	"localeRoutes": {},
	"optionalRoutes": {},
	"imageLayout": "constrained",
	"routes": [
		"/",
		"/about",
		"/admin",
		"/contact",
		"/projects",
		"/reviews"
	],
	"routeSegments": [],
	"icons": [
		"Icons%2Flogo-black",
		"Icons%2Fsun",
		"check",
		"content-circles",
		"cta-squares",
		"logo-black",
		"logo-white",
		"mdi--caret",
		"moon",
		"play",
		"profile",
		"quote-white",
		"service1",
		"service2",
		"service3",
		"stars",
		"stars-yellow",
		"sun"
	],
	"globalRules": {
		".cs-topper": {
			"font-size": "var(--topperfontsize)",
			"font-weight": "700",
			"line-height": "1.2em",
			"text-transform": "uppercase",
			"letter-spacing": "0.1em",
			"color": "var(--secondary)",
			"display": "block"
		},
		".cs-title": {
			"font-size": "var(--headerfontsize)",
			"font-weight": "900",
			"line-height": "1.2em",
			"margin": "0 auto (16/16rem)",
			"color": "var(--headercolor)",
			"position": "relative"
		},
		".cs-text": {
			"font-size": "var(--bodyfontsize)",
			"line-height": "1.5em",
			"width": "100%",
			"margin": "0 auto",
			"color": "var(--bodytextcolor)"
		},
		".cs-button-solid": {
			"font-size": "(16/16rem)",
			"font-weight": "bold",
			"line-height": "(50/16em)",
			"text-align": "center",
			"text-transform": "uppercase",
			"text-decoration": "none",
			"width": "auto",
			"height": "(50/16rem)",
			"padding": "0 (30/16rem)",
			"color": "#000",
			"background-color": "var(--primary)",
			"display": "inline-block",
			"position": "relative",
			"z-index": "1",
			"transition": "color 0.3s",
			"transition-delay": "0.1s"
		}
	},
	"globalRootVars": [
		"--bodyFontSize",
		"--bodyTextColor",
		"--bodyTextColorWhite",
		"--headerColor",
		"--headerFontSize",
		"--primary",
		"--primaryLight",
		"--secondary",
		"--secondaryLight",
		"--sectionPadding",
		"--topperFontSize"
	],
	"cspicture": {
		"exists": true,
		"props": [
			"mobileImgUrl",
			"mobileMediaWidth",
			"desktopImgUrl",
			"desktopMediaWidth",
			"fallbackImgUrl",
			"alt"
		],
		"supportsArtDirection": true
	},
	"businessData": {
		"exists": true,
		"exportName": "BUSINESS",
		"importPath": "@data/client",
		"socials": [
			"facebook",
			"instagram"
		]
	},
	"navScript": {
		"exists": true,
		"hooks": [
			"cs-navigation",
			"cs-toggle",
			"cs-active",
			"cs-open",
			"cs-ul-wrapper",
			"cs-dropdown",
			"cs-drop-ul"
		],
		"fingerprint": [
			"\" \"",
			"\"#cs-navigation .cs-toggle\"",
			"\"#cs-navigation\"",
			"\"#cs-ul-wrapper\"",
			"\"#dark-mode-toggle\"",
			"\".cs-drop-ul\"",
